#include <windows.h>

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@RECALL_BUILD_REVISION@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@RECALL_BUILD_REVISION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ReCall quick launcher\0"
            VALUE "FileVersion", "@RECALL_VERSION@\0"
            VALUE "InternalName", "ReCall\0"
            VALUE "OriginalFilename", "ReCall.exe\0"
            VALUE "ProductName", "ReCall\0"
            VALUE "ProductVersion", "@RECALL_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
